{
  "schema": "cordis-verus.scoped-negative-manifest/v2",
  "negativeMode": "scoped-negative",
  "cases": [
    {
      "name": "r3-source-call-fabricates-position",
      "mutation": {
        "file": "reversible_value/managed/replay/order.rs",
        "old": "{Self {revision,stream}}",
        "new": "{Self {revision:Some(0),stream}}"
      },
      "targets": [
        {
          "kind": "module",
          "path": "reversible_value::managed::replay::order",
          "descendants": false,
          "function": "cordis_negative::reversible_value::managed::replay::order::CallPosition::new"
        }
      ],
      "expectedFailures": [
        {
          "function": "cordis_negative::reversible_value::managed::replay::order::CallPosition::new",
          "module": "reversible_value::managed::replay::order",
          "file": "reversible_value/managed/replay/order.rs",
          "diagnosticKind": "postcondition not satisfied",
          "uniqueSourceAnchor": "ensures out.revision==revision,out.stream==stream,"
        }
      ],
      "selectionRationale": "The real CallPosition stored by source capture must retain the actual non-wrapping recipe revision with its stream. The constructor is checked independently of the large invocation report; Source separately proves its completion-receipt link. Require a matching positive, compiling mutant and designated postcondition failure. Timeouts and frontend failures do not count."
    },
    {
      "name": "r3-typed-landing-skips-version",
      "mutation": {
        "file": "reversible_value/payload/restoration.rs",
        "old": "if revision!=expected.revision() {",
        "new": "if false {"
      },
      "targets": [
        {
          "kind": "module",
          "path": "reversible_value::payload::restoration",
          "descendants": false,
          "function": "cordis_negative::reversible_value::payload::SharedPayload::apply_captured_in"
        }
      ],
      "expectedFailures": [
        {
          "function": "cordis_negative::reversible_value::payload::SharedPayload::apply_captured_in",
          "module": "reversible_value::payload::restoration",
          "file": "reversible_value/payload/restoration.rs",
          "diagnosticKind": "assertion failed",
          "uniqueSourceAnchor": "assert(cell.authority@.events() =~= expected.observation().states);"
        }
      ],
      "selectionRationale": "A captured typed input must still be current under the same write lock that performs the real mutation. Require a matching positive, a compiling mutant and rejection at the designated assertion. Timeouts, frontend errors and unrelated proof failures do not count."
    }
  ]
}
