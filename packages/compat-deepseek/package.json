{
  "name": "@validation-engineering/cordis-compat-deepseek",
  "version": "0.1.0",
  "type": "module",
  "description": "Compatibility with @deepseek-ai/cordis over the Rust/Verus Cordis runtime; not the DeepSeek Harness application",
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./register": "./register.js"
  },
  "peerDependencies": {
    "@validation-engineering/cordis": "0.1.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/validation-engineering/cordis-verus.git",
    "directory": "packages/compat-deepseek"
  },
  "homepage": "https://github.com/validation-engineering/cordis-verus#readme",
  "bugs": {
    "url": "https://github.com/validation-engineering/cordis-verus/issues"
  },
  "files": [
    "*.js",
    "*.cjs",
    "*.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
