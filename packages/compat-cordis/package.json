{
  "name": "@validation-engineering/cordis",
  "version": "0.2.0",
  "type": "module",
  "description": "Experimental Cordis language facade over the Rust lifecycle driver",
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./utils": "./utils.js",
    "./register": "./register.js",
    "./bootstrap": "./bootstrap.js",
    "./native-artifacts": {
      "types": "./native-artifacts.d.ts",
      "import": "./native-artifacts.js",
      "require": "./native-artifacts.js"
    }
  },
  "license": "MIT",
  "files": [
    "*.js",
    "*.cjs",
    "*.d.ts",
    "README.md",
    "LICENSE",
    "LICENSE.upstream",
    "NOTICE",
    "native/cordis.node",
    "native/manifest.json",
    "native/provenance/*.json",
    "native/prebuilds/*/cordis.node"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/validation-engineering/cordis-verus.git",
    "directory": "packages/compat-cordis"
  },
  "homepage": "https://github.com/validation-engineering/cordis-verus#readme",
  "bugs": {
    "url": "https://github.com/validation-engineering/cordis-verus/issues"
  }
}
