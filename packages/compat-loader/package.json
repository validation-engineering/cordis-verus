{
  "name": "@validation-engineering/cordis-loader",
  "version": "0.2.0",
  "type": "module",
  "description": "Experimental JSON module loader over the native Cordis facade",
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./worker": {
      "types": "./worker.d.ts",
      "import": "./worker.js"
    },
    "./process": {
      "types": "./process.d.ts",
      "import": "./process.js"
    },
    "./rust-module": {
      "types": "./rust-module.d.ts",
      "import": "./rust-module.js"
    },
    "./rust-module-plugin": {
      "types": "./rust-module-plugin.d.ts",
      "import": "./rust-module-plugin.js"
    }
  },
  "peerDependencies": {
    "@validation-engineering/cordis": "0.1.1"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/validation-engineering/cordis-verus.git",
    "directory": "packages/compat-loader"
  },
  "homepage": "https://github.com/validation-engineering/cordis-verus#readme",
  "bugs": {
    "url": "https://github.com/validation-engineering/cordis-verus/issues"
  },
  "files": [
    "*.js",
    "*.cjs",
    "*.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
