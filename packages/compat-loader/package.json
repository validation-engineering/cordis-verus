{
  "name": "@cordis-verus/compat-loader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Experimental JSON module loader over the native Cordis facade",
  "engines": {
    "node": ">=22.22.0"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./worker": {
      "types": "./worker.d.ts",
      "import": "./worker.js"
    },
    "./harness": {
      "types": "./harness.d.ts",
      "import": "./harness.js"
    },
    "./process": {
      "types": "./process.d.ts",
      "import": "./process.js"
    },
    "./rust-module": {
      "types": "./rust-module.d.ts",
      "import": "./rust-module.js"
    },
    "./rust-module-plugin": {
      "types": "./rust-module-plugin.d.ts",
      "import": "./rust-module-plugin.js"
    }
  },
  "peerDependencies": {
    "@cordis-verus/compat-cordis": "0.1.0"
  },
  "license": "MIT"
}
